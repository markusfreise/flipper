# Wird von flohmarkt-deploy.sh aus /opt/infra/.env gerendert. Nicht von Hand bearbeiten.
APP_NAME=Flohmarkt
APP_ENV=production
APP_KEY=${FLOHMARKT_APP_KEY}
APP_DEBUG=false
APP_URL=https://flohmarkt.croeso.de
APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=192.168.2.110
DB_PORT=5432
DB_DATABASE=flohmarkt
DB_USERNAME=flohmarkt_app
DB_PASSWORD=${FLOHMARKT_DB_PASS}

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
FILESYSTEM_DISK=local
SANCTUM_STATEFUL_DOMAINS=flohmarkt.croeso.de

ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_WEB_SEARCHES=5
FLOHMARKT_FAKE_AI=false

REMBG_URL=http://192.168.2.111:7000
REMBG_MODEL=isnet-general-use
REMBG_TIMEOUT=180

LISTING_RETENTION_DAYS=90
PICKUP_LOCATION="Bielefeld-West"
NTFY_URL=${NTFY_URL}
NTFY_TOPIC=flohmarkt
FLOHMARKT_DEPLOY_SECRET=${FLOHMARKT_DEPLOY_SECRET}

MAIL_MAILER=log
