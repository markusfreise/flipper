[Unit]
Description=Flipper Queue Worker
After=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/flipper
ExecStart=/usr/bin/php8.3 /var/www/flipper/artisan queue:work --sleep=3 --tries=3 --timeout=300 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
