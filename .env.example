APP_NAME=Flohmarkt
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://flohmarkt.test
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flohmarkt_local
DB_USERNAME=flohmarkt_app
DB_PASSWORD=

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360
SESSION_DRIVER=database
SESSION_LIFETIME=10080
CACHE_STORE=database
FILESYSTEM_DISK=local
SANCTUM_STATEFUL_DOMAINS=flohmarkt.test,localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_WEB_SEARCHES=5
# Lokal ohne API-Key: Luna-Fixtures statt Claude
FLOHMARKT_FAKE_AI=false

REMBG_URL=http://127.0.0.1:7000
REMBG_MODEL=isnet-general-use
REMBG_TIMEOUT=180

LISTING_RETENTION_DAYS=90
PICKUP_LOCATION="Bielefeld-West"
NTFY_URL=
NTFY_TOPIC=flohmarkt

# Nur prod: HMAC-Secret des GitHub-Webhooks (/deploy-hook)
FLOHMARKT_DEPLOY_SECRET=

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
